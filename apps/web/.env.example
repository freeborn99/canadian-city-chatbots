# Upstash Vector Serverless Index (Get free from https://console.upstash.com/vector)
UPSTASH_VECTOR_REST_URL=https://your-index-url.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your-upstash-vector-rest-token

# AI Provider: Groq API Key (Free tier from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Alternative AI Provider: Google Gemini API Key (Free tier from https://aistudio.google.com)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Active AI Provider Model ('groq' | 'google')
AI_PROVIDER=groq

# Admin Portal Access Token (required for /admin dashboard and admin API routes)
ADMIN_API_TOKEN=your-secure-admin-token-here

# Affiliate & Partner Network Integrations
RAKUTEN_CLIENT_ID=your-rakuten-client-id
RAKUTEN_CLIENT_SECRET=your-rakuten-client-secret
RAKUTEN_API_TOKEN=your-rakuten-bearer-token-optional
CJ_PERSONAL_ACCESS_TOKEN=your-cj-personal-access-token
CJ_COMPANY_ID=your-cj-company-id
IMPACT_ACCOUNT_SID=your-impact-account-sid
IMPACT_AUTH_TOKEN=your-impact-auth-token
VIATOR_API_KEY=your-viator-api-key
