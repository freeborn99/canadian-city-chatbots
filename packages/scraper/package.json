{
  "name": "@canadian-chatbots/scraper",
  "version": "1.0.0",
  "description": "Automated Cheerio scraper and Upstash Vector ingestion for Canadian city portals",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node --transpile-only src/index.ts",
