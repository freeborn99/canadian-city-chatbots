{
  "name": "canadian-city-chatbots-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-cost multi-tenant Canadian city AI chatbot and automated scraper monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "scrape": "npm run start --workspace=packages/scraper",
    "scrape:dev": "npm run dev --workspace=packages/scraper"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "npm@10.8.2"
}
